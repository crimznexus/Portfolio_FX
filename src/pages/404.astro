---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="wrap nf">
    <p class="label">404</p>
    <h1>This page isn’t here.</h1>
    <p>It may have moved, or the link had a typo. <a href="/">Go to the home page</a> or <a href="/#work">see the work</a>.</p>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(5rem, 14vw, 10rem) 0; display: grid; gap: 1.25rem; }
  h1 { font-size: var(--step-4); }
  p:last-child { color: var(--ink-2); font-size: var(--step-1); }
</style>
