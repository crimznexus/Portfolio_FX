---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import { projects, type Project } from '../../data/projects';

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next: Project;
}

const { project: p, next } = Astro.props;
const phones = p.gallery.filter((g) => g.kind === 'phone').length;
const galleryMode = phones === p.gallery.length ? 'phones' : 'mixed';
---

<Base title={p.name} description={p.summary}>
  <div class="progress" aria-hidden="true"></div>

  <article class="case">
    <header class="case-head wrap">
      <a class="back label" href="/#work" data-reveal>← All work</a>
      <p class="label kicker" data-reveal data-delay="80">{p.platform} · {p.year}</p>
      <h1 class="display" data-vt={p.slug} data-reveal data-delay="160">{p.name}</h1>
      <p class="summary shadow-text" data-reveal data-delay="240">{p.summary}</p>

      <dl class="facts" data-reveal data-delay="320">
        <div><dt class="label">Role</dt><dd>{p.role}</dd></div>
        <div><dt class="label">Status</dt><dd>{p.status}</dd></div>
        <div class="stack"><dt class="label">Built with</dt><dd>{p.stack.join(' · ')}</dd></div>
        {
          p.links.length > 0 && (
            <div>
              <dt class="label">Links</dt>
              <dd>
                {p.links.map((l) => (
                  <a href={l.href}>{l.label} ↗</a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="wrap">
      <figure class:list={['cover', p.cover.kind]} data-reveal>
        <Shot shot={p.cover} sizes="(width < 60rem) 92vw, 64rem" eager />
      </figure>
    </div>

    <div class="wrap body">
      <section class="block" aria-labelledby="s-context">
        <h2 id="s-context" data-reveal>Context</h2>
        <div class="prose" data-reveal data-delay="100">
          {p.intro.map((para) => <p>{para}</p>)}
        </div>
      </section>

      <section class="block" aria-labelledby="s-built">
        <h2 id="s-built" data-reveal>What I built</h2>
        <ul class="built" role="list" data-reveal data-delay="100">
          {p.built.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="block" aria-labelledby="s-decisions">
        <h2 id="s-decisions" data-reveal>Decisions worth mentioning</h2>
        <div class="decisions">
          {
            p.decisions.map((d, i) => (
              <div class="decision glass" data-reveal data-delay={100 + i * 110}>
                <h3>{d.title}</h3>
                <p>{d.body}</p>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <section class="gallery-wrap wrap" aria-labelledby="s-gallery">
      <div class="gallery-head" data-reveal>
        <h2 id="s-gallery">Screens</h2>
        <p class="label">{p.captureNote}</p>
      </div>
      <ul class:list={['gallery', galleryMode]} role="list">
        {
          p.gallery.map((g, i) => (
            <li class:list={[g.kind]} data-reveal data-delay={Math.min(i, 3) * 90}>
              <button
                class="open"
                type="button"
                commandfor={`lb-${i}`}
                command="show-modal"
                aria-label={`Enlarge: ${g.caption ?? g.alt}`}
              >
                <Shot shot={g} sizes={g.kind === 'phone' ? '(width < 48rem) 45vw, 16rem' : '(width < 48rem) 92vw, 40rem'} />
              </button>
              {g.caption && <p class="label cap">{g.caption}</p>}
              <dialog id={`lb-${i}`} class="lightbox" closedby="any" aria-label={g.caption ?? g.alt}>
                <Shot shot={g} sizes="92vw" />
                <form method="dialog">
                  <button class="close label">Close</button>
                </form>
              </dialog>
            </li>
          ))
        }
      </ul>
    </section>

    <nav class="next wrap" aria-label="Next project">
      <a class="glass" href={`/work/${next.slug}`} data-reveal>
        <span class="label">Next project</span>
        <span class="next-name" data-vt={next.slug}>{next.name}</span>
        <span class="next-sum">{next.summary}</span>
      </a>
    </nav>
  </article>
</Base>

<script>
  // Invoker Commands open the dialogs natively where supported; these cover the rest.
  if (!('command' in HTMLButtonElement.prototype)) {
    document.querySelectorAll<HTMLButtonElement>('button[commandfor]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const d = document.getElementById(btn.getAttribute('commandfor') ?? '');
        if (d instanceof HTMLDialogElement) d.showModal();
      });
    });
  }
  if (!('closedBy' in HTMLDialogElement.prototype)) {
    document.querySelectorAll<HTMLDialogElement>('dialog.lightbox').forEach((d) => {
      d.addEventListener('click', (e) => {
        if (e.target === d) d.close();
      });
    });
  }
</script>

<style>
  /* Reading progress, driven by the scroll timeline rather than a listener. */
  .progress {
    position: fixed;
    inset: 0 0 auto;
    height: 2px;
    background: var(--ink);
    transform-origin: 0 50%;
    scale: 0 1;
    z-index: 60;
  }
  @supports (animation-timeline: scroll()) {
    .progress { animation: grow linear both; animation-timeline: scroll(root); }
    @keyframes grow { to { scale: 1 1; } }
  }
  @supports not (animation-timeline: scroll()) { .progress { display: none; } }

  .case-head { padding-block: 7rem 2.5rem; }
  .back { display: inline-block; margin-bottom: 2.5rem; }
  .back:hover { color: var(--ink); }
  .kicker { margin-bottom: 0.75rem; }
  h1 { width: fit-content; }
  .summary {
    margin-top: 1.25rem;
    max-width: 44ch;
    font-size: var(--step-2);
    line-height: 1.6;
    color: var(--ink-80);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: 1.25rem 2rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .facts div { display: grid; gap: 0.35rem; align-content: start; }
  .facts .stack { grid-column: span 2; }
  @media (width < 40rem) { .facts .stack { grid-column: auto; } }
  .facts dd { margin: 0; font-size: var(--step-0); }
  .facts dd a { display: block; border-bottom: 1px solid var(--line-strong); width: fit-content; }

  .cover { margin: 0; display: grid; place-items: start; }
  .cover :global(.frame) {
    width: 100%;
    max-width: 64rem;
    border-radius: 12px;
    overflow: clip;
    border: 1px solid var(--line);
    box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.9);
  }
  .cover.phone :global(.frame) { width: min(20rem, 70%); }

  .body { display: grid; gap: clamp(3rem, 7vw, 5rem); padding-block: clamp(3.5rem, 8vw, 6rem); }
  .block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: clamp(1rem, 4vw, 3.5rem);
  }
  @media (width < 52rem) { .block { grid-template-columns: 1fr; } }
  .block h2 { font-size: var(--step-3); }
  .prose { display: grid; gap: 1rem; max-width: 60ch; font-size: var(--step-2); line-height: 1.65; }
  .prose p + p { color: var(--ink-70); }

  .built { display: grid; max-width: 62ch; }
  .built li {
    position: relative;
    padding: 0.85rem 0 0.85rem 1.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-80);
  }
  .built li:first-child { border-top: 1px solid var(--line); }
  .built li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.5rem;
    width: 0.6rem;
    height: 1px;
    background: var(--ink-40);
  }

  .decisions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 0.75rem;
  }
  .decision { border-radius: 14px; padding: 1.35rem 1.5rem 1.6rem; display: grid; gap: 0.6rem; align-content: start; }
  .decision h3 { font-size: var(--step-2); font-weight: 500; }
  .decision p { font-size: var(--step-0); line-height: 1.65; color: var(--ink-70); }

  .gallery-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .gallery-head h2 { font-size: var(--step-3); }
  .gallery {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2.5vw, 1.75rem);
    grid-template-columns: repeat(auto-fill, minmax(min(24rem, 100%), 1fr));
    align-items: start;
  }
  .gallery.phones { grid-template-columns: repeat(auto-fill, minmax(min(12rem, 42%), 1fr)); }
  .gallery.mixed li.phone { max-width: 15rem; }
  .gallery li { display: grid; gap: 0.6rem; }
  .open { display: block; width: 100%; cursor: zoom-in; text-align: start; }
  .open :global(.frame) {
    border-radius: 10px;
    overflow: clip;
    border: 1px solid var(--line);
    box-shadow: 0 30px 70px -30px rgb(0 0 0 / 0.85);
    transition: translate 0.35s var(--ease-out), border-color 0.35s;
  }
  .open:hover :global(.frame) { translate: 0 -4px; border-color: var(--line-strong); }

  .lightbox {
    max-width: min(92vw, 88rem);
    max-height: 92dvh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
    margin: auto;
    opacity: 1;
    scale: 1;
    transition: opacity 0.25s, scale 0.3s var(--ease-out), display 0.3s allow-discrete, overlay 0.3s allow-discrete;
    &:not([open]) { opacity: 0; scale: 0.97; }
    @starting-style { &[open] { opacity: 0; scale: 0.97; } }
    &::backdrop {
      background: rgb(6 6 6 / 0.9);
      backdrop-filter: blur(8px);
      transition: opacity 0.25s, display 0.3s allow-discrete, overlay 0.3s allow-discrete;
    }
    &:not([open])::backdrop { opacity: 0; }
    @starting-style { &[open]::backdrop { opacity: 0; } }
  }
  .lightbox :global(.frame) { max-height: 86dvh; width: auto; border-radius: 10px; overflow: clip; }
  .lightbox :global(.frame img) { max-height: 86dvh; width: auto; margin-inline: auto; }
  .lightbox form { text-align: center; margin-top: 0.75rem; }
  .close { padding: 0.4rem 0.8rem; color: var(--ink-70); }
  .close:hover { color: var(--ink); }

  .next { margin-top: clamp(4rem, 10vw, 7rem); }
  .next a {
    display: grid;
    gap: 0.5rem;
    border-radius: 16px;
    padding: clamp(1.75rem, 5vw, 3rem);
    transition: background-color 0.3s, border-color 0.3s;
  }
  .next a:hover { background: rgb(255 255 255 / 0.16); border-color: var(--line-strong); }
  .next-name {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    width: fit-content;
  }
  .next-sum { color: var(--ink-70); max-width: 50ch; font-size: var(--step-0); }
</style>
