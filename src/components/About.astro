---
const toolkit = [
  {
    group: 'Interfaces',
    items: ['React 19', 'Next.js', 'Astro', 'TanStack Start', 'React Native & Expo', 'Tailwind CSS', 'shadcn/ui'],
  },
  {
    group: 'The platform',
    items: ['TypeScript', 'Modern CSS', 'View Transitions', 'Accessibility', 'PWAs & service workers', 'Performance budgets'],
  },
  {
    group: 'When the product needs it',
    items: ['Node.js', 'Convex', 'SQLite', 'Socket.io', 'Python & PySide6', 'Kotlin & Android', 'Docker'],
  },
  {
    group: 'Every day',
    items: ['Vite', 'Vitest', 'Playwright', 'Git & GitHub Actions', 'Vercel'],
  },
];
---

<section id="about" class="about wrap" aria-labelledby="about-title">
  <div class="intro">
    <h2 id="about-title">How I work</h2>
    <div class="prose">
      <p>
        I like interfaces that feel obvious: a clear hierarchy, honest states, and a screen that
        tells you what to do next.
      </p>
      <p>
        I work close to the platform, with semantic HTML, modern CSS and only as much JavaScript as
        the job needs. Accessibility and performance are part of the design, not a pass at the end.
        I can work across the stack when a product needs it, but the interface is where I do my best
        work.
      </p>
    </div>
  </div>

  <dl class="toolkit" aria-label="Toolkit">
    {
      toolkit.map((t) => (
        <div class="panel">
          <dt class="label">{t.group}</dt>
          <dd>
            <ul role="list">
              {t.items.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    padding-block: clamp(5rem, 11vw, 8.5rem) 0;
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(1rem, 4vw, 4rem);
  }
  @media (width < 52rem) { .intro { grid-template-columns: 1fr; } }
  h2 { font-size: var(--step-3); }
  .prose { font-size: var(--step-1); line-height: 1.65; max-width: 48ch; }
  .prose p + p { color: var(--ink-2); }

  /* Four panels that reflow on their own width, not the window's. */
  .toolkit {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: 0.75rem;
  }
  .toolkit > div { padding: 1.2rem 1.3rem 1.4rem; display: grid; gap: 0.8rem; align-content: start; }
  dd { margin: 0; }
  ul { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  li {
    font-size: var(--step--1);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--paper-3);
    color: var(--ink);
  }
</style>
