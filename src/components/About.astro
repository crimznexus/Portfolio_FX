---
const toolkit = [
  {
    group: 'Interfaces',
    items: ['React 19', 'Next.js', 'Astro', 'TanStack Start', 'React Native & Expo', 'Tailwind CSS', 'shadcn/ui'],
  },
  {
    group: 'The platform',
    items: ['TypeScript', 'Modern CSS', 'View Transitions', 'Accessibility', 'PWAs & service workers', 'Performance budgets'],
  },
  {
    group: 'When the product needs it',
    items: ['Node.js', 'Convex', 'SQLite', 'Socket.io', 'Python & PySide6', 'Kotlin & Android', 'Docker'],
  },
  {
    group: 'Every day',
    items: ['Vite', 'Vitest', 'Playwright', 'Git & GitHub Actions', 'Vercel'],
  },
];
---

<section id="about" class="about wrap" aria-labelledby="about-title">
  <h2 id="about-title">How I work</h2>

  <div class="body">
    <div class="prose">
      <p>
        I like interfaces that feel obvious: a clear hierarchy, honest states, and a screen that
        tells you what to do next.
      </p>
      <p>
        I work close to the platform, with semantic HTML, modern CSS and only as much JavaScript as
        the job needs. Accessibility and performance are part of the design, not a pass at the end.
        I can work across the stack when a product needs it, but the interface is where I do my best
        work.
      </p>
    </div>

    <div class="toolkit">
      <h3 class="label">Toolkit</h3>
      <dl>
        {
          toolkit.map((t) => (
            <div>
              <dt>{t.group}</dt>
              <dd>{t.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-block: clamp(4rem, 10vw, 8rem) 0;
    container: about / inline-size;
  }
  @media (width < 52rem) { .about { grid-template-columns: 1fr; } }

  h2 { font-size: var(--step-2); }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  @container about (width < 56rem) {
    .body { grid-template-columns: 1fr; }
  }
  .prose { font-size: var(--step-1); line-height: 1.6; max-width: 46ch; }
  .prose p + p { color: var(--ink-2); }

  .toolkit h3 { margin-bottom: 1rem; }
  dl { display: grid; gap: 1.1rem; }
  dl > div { display: grid; gap: 0.2rem; padding-top: 0.9rem; border-top: 1px solid var(--line); }
  dt { font-weight: 600; font-size: var(--step--1); }
  dd { margin: 0; color: var(--ink-2); font-size: var(--step--1); }
</style>
