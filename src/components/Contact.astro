---
import { contact } from '../data/contact';

const links = [contact.linkedin, contact.github, contact.telegram];
const labels = ['LinkedIn', 'GitHub', 'Telegram'];
---

<section id="contact" class="contact wrap" aria-labelledby="contact-title">
  <div class="card glass" data-reveal>
    <div class="lead">
      <p class="badge">Contact</p>
      <h2 id="contact-title" class="display">Let’s talk.</h2>
      <p class="sub shadow-text">Open to frontend roles. Email is the quickest way to reach me.</p>
    </div>

    <div class="email-row" data-reveal data-delay="120">
      <a class="email" href={`mailto:${contact.email}`}>{contact.email}</a>
      <button class="btn ghost copy" type="button" data-copy={contact.email} aria-describedby="copied">
        Copy
      </button>
      <p id="copied" popover="manual" role="status">Copied to clipboard</p>
    </div>

    <ul class="links" role="list" data-reveal data-delay="220">
      {
        links.map((l, i) => (
          <li>
            <a href={l.href}>
              <span class="label">{labels[i]}</span>
              <span class="handle">{l.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.copy');
  const toast = document.getElementById('copied');
  let timer: number | undefined;
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
    } catch {
      return;
    }
    toast?.showPopover?.();
    clearTimeout(timer);
    timer = window.setTimeout(() => toast?.hidePopover?.(), 1800);
  });
</script>

<style>
  .contact { padding-top: clamp(5rem, 12vw, 9rem); }
  .card {
    display: grid;
    gap: clamp(2rem, 4vw, 2.75rem);
    border-radius: 20px;
    padding: clamp(1.75rem, 5vw, 3.5rem);
  }
  .sub { margin-top: 1rem; color: var(--ink-80); font-size: var(--step-2); }
  .lead .badge { margin-bottom: 1.25rem; }
  h2 { max-width: 14ch; }

  .email-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }
  .email {
    font-size: clamp(1.25rem, 0.9rem + 1.8vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.15em;
    &:hover { border-color: var(--ink); }
  }
  .copy { padding: 0.45rem 1rem; }

  /* Manual popover pinned above the button with CSS anchor positioning. */
  .copy { anchor-name: --copy; }
  #copied {
    position-anchor: --copy;
    position-area: block-start center;
    margin: 0 0 0.5rem;
    inset: auto;
    padding: 0.4rem 0.75rem;
    border: 0;
    border-radius: 8px;
    background: var(--ink);
    color: #000;
    font-size: var(--step-0);
    opacity: 1;
    translate: 0 0;
    transition: opacity 0.2s, translate 0.25s var(--ease-out), display 0.25s allow-discrete, overlay 0.25s allow-discrete;
    &:not(:popover-open) { opacity: 0; translate: 0 4px; }
    @starting-style { &:popover-open { opacity: 0; translate: 0 4px; } }
  }
  @supports not (position-anchor: --x) {
    #copied { position: fixed; inset: auto auto 1.5rem 50%; translate: -50% 0; }
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
    gap: 0.75rem;
  }
  .links a {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 1.1rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.06);
    transition: background-color 0.3s, border-color 0.3s;
    &:hover { background: rgb(255 255 255 / 0.14); border-color: var(--line-strong); }
  }
  .handle { font-size: var(--step-0); }
</style>
