---
import { contact } from '../data/contact';
---

<section id="contact" class="contact wrap" aria-labelledby="contact-title">
  <div class="card panel">
    <div class="lead">
      <p class="label">Contact</p>
      <h2 id="contact-title">I’m looking for a frontend role where the details matter.</h2>
      <p class="sub">Email is the quickest way to reach me.</p>
    </div>

    <div class="email-row">
      <a class="email" href={`mailto:${contact.email}`}>{contact.email}</a>
      <button class="copy" type="button" data-copy={contact.email} aria-describedby="copied">Copy</button>
      <p id="copied" popover="manual" role="status">Copied to clipboard</p>
    </div>

    <ul class="links" role="list">
      <li><a href={contact.linkedin.href}><span class="label">LinkedIn</span>{contact.linkedin.label}</a></li>
      <li><a href={contact.github.href}><span class="label">GitHub</span>{contact.github.label}</a></li>
      <li><a href={contact.telegram.href}><span class="label">Telegram</span>{contact.telegram.label}</a></li>
    </ul>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.copy');
  const toast = document.getElementById('copied');
  let timer: number | undefined;
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
    } catch {
      return;
    }
    toast?.showPopover?.();
    clearTimeout(timer);
    timer = window.setTimeout(() => toast?.hidePopover?.(), 1800);
  });
</script>

<style>
  .contact { padding-block: clamp(4.5rem, 10vw, 7rem) 0; }
  .card {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.75rem, 5vw, 4rem);
    background:
      radial-gradient(90% 120% at 100% 100%, color-mix(in oklab, var(--accent) 12%, transparent), transparent 60%),
      var(--paper-2);
  }
  h2 { font-size: var(--step-3); max-width: 20ch; margin-block: 0.75rem 1rem; }
  .sub { color: var(--ink-2); font-size: var(--step-1); }

  .email-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }
  .email {
    font-family: var(--font-display-stack);
    font-size: min(var(--step-3), 7vw);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--accent);
    overflow-wrap: break-word;
    &:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  }
  .copy {
    anchor-name: --copy;
    font-size: var(--step--1);
    padding: 0.45rem 1rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow 0.2s, background-color 0.2s;
    &:hover { box-shadow: inset 0 0 0 1px var(--ink-2); }
    &:active { background: var(--paper-3); }
  }

  /* Manual popover in the top layer, pinned above the button with anchor positioning. */
  #copied {
    position-anchor: --copy;
    position-area: block-start center;
    margin: 0 0 0.5rem;
    inset: auto;
    padding: 0.4rem 0.75rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--paper);
    font-size: var(--step--1);
    opacity: 1;
    translate: 0 0;
    transition: opacity 0.2s, translate 0.25s var(--ease-out), display 0.25s allow-discrete, overlay 0.25s allow-discrete;
    &:not(:popover-open) { opacity: 0; translate: 0 4px; }
    @starting-style {
      &:popover-open { opacity: 0; translate: 0 4px; }
    }
  }
  @supports not (position-anchor: --x) {
    #copied { position: fixed; inset: auto auto 1.5rem 50%; translate: -50% 0; }
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    gap: 0.75rem;
  }
  .links a {
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--paper-3);
    text-decoration: none;
    transition: background-color 0.2s;
    &:hover { background: color-mix(in oklab, var(--paper-3) 70%, var(--accent)); }
  }
</style>
