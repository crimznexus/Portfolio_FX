---
const path = Astro.url.pathname;
const isHome = path === '/' || path === '/index';
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header wrap">
  <a class="name" href="/" aria-current={isHome ? 'page' : undefined}>
    Muhammad Faizan
  </a>

  <nav aria-label="Main">
    <ul role="list">
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      <li>
        <button class="theme-btn" popovertarget="theme-menu" aria-label="Choose colour theme">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5Z" fill="currentColor"></path>
          </svg>
        </button>
        <div id="theme-menu" popover>
          <fieldset>
            <legend class="label">Theme</legend>
            <label><input type="radio" name="theme" value="system" checked /> Match system</label>
            <label><input type="radio" name="theme" value="light" /> Light</label>
            <label><input type="radio" name="theme" value="dark" /> Dark</label>
          </fieldset>
        </div>
      </li>
    </ul>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const radios = document.querySelectorAll<HTMLInputElement>('input[name="theme"]');
  const current = root.dataset.theme ?? 'system';
  radios.forEach((r) => {
    r.checked = r.value === current;
    r.addEventListener('change', () => {
      const apply = () => {
        if (r.value === 'system') delete root.dataset.theme;
        else root.dataset.theme = r.value;
      };
      // Same-document view transition gives the theme swap a soft crossfade.
      if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.startViewTransition(apply);
      } else apply();
      try {
        if (r.value === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', r.value);
      } catch {}
    });
  });
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    view-transition-name: site-header;
  }
  .name {
    font-family: var(--font-display-stack);
    font-size: var(--step-1);
    font-weight: 600;
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 11;
    text-decoration: none;
    letter-spacing: 0;
  }
  ul {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.5vw, 2rem);
  }
  nav a {
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--ink-2);
    &:hover { color: var(--ink); }
  }
  @media (width < 34rem) {
    nav li:has(> a[href='/#about']) { display: none; }
  }

  .theme-btn {
    anchor-name: --theme-btn;
    display: grid;
    place-items: center;
    width: 2.25rem;
    aspect-ratio: 1;
    border-radius: 50%;
    color: var(--ink-2);
    transition: color 0.2s, background-color 0.2s;
    &:hover { color: var(--ink); background: var(--paper-2); }
  }

  /* Popover placed with CSS anchor positioning; flips above if there is no room below. */
  #theme-menu {
    position-anchor: --theme-btn;
    position-area: block-end span-inline-start;
    position-try-fallbacks: flip-block, flip-inline;
    margin: 0.5rem 0 0;
    inset: auto;
    padding: 0.9rem 1rem 1rem;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 18px 40px -20px color-mix(in oklch, var(--ink) 45%, transparent);
    opacity: 1;
    translate: 0 0;
    transition: opacity 0.18s, translate 0.18s var(--ease-out), display 0.18s allow-discrete, overlay 0.18s allow-discrete;

    &:not(:popover-open) { opacity: 0; translate: 0 -4px; }
    @starting-style {
      &:popover-open { opacity: 0; translate: 0 -4px; }
    }
  }
  /* Browsers without anchor positioning get a sensible fixed spot. */
  @supports not (position-anchor: --x) {
    #theme-menu { position: fixed; inset: 4rem var(--gutter) auto auto; }
  }
  fieldset { border: 0; padding: 0; display: grid; gap: 0.45rem; min-width: 11rem; }
  legend { margin-bottom: 0.4rem; }
  label { display: flex; gap: 0.6rem; align-items: center; font-size: var(--step--1); cursor: pointer; }
</style>
