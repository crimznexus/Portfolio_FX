---
import Shot from './Shot.astro';
import { projects } from '../data/projects';

// Which gallery screens appear on the home page, in order.
const pick: Record<string, number[]> = {
  milksage: [0, 1],
  grainova: [0, 1, 2, 3],
  delphi: [0, 1],
  nexushost: [0, 1],
  kiwami: [0, 1],
};

const MAX_ROW_HEIGHT = 30; // rem
---

<section id="work" class="work wrap" aria-label="Projects">
  <div class="head" data-reveal>
    <p class="badge">Selected work</p>
    <p class="label count">{projects.length} projects · 2026</p>
  </div>

  {
    projects.map((p, n) => {
      const shots = (pick[p.slug] ?? [0]).map((i) => p.gallery[i]).filter(Boolean);
      const ratios = shots.map((s) => s.src.width / s.src.height);
      const total = ratios.reduce((a, b) => a + b, 0);
      return (
        <article class="project" aria-labelledby={`t-${p.slug}`}>
          <header class="meta">
            <div data-reveal data-delay="60">
              <p class="label idx">{String(n + 1).padStart(2, '0')} · {p.platform}</p>
              <h2 id={`t-${p.slug}`} class="name" data-vt={p.slug}>{p.name}</h2>
            </div>
            <div class="right" data-reveal data-delay="160">
              <p class="summary shadow-text">{p.summary}</p>
              <a class="more" href={`/work/${p.slug}`}>
                Case study
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"></path>
                </svg>
              </a>
            </div>
          </header>

          {/* Justified row: each screen's flex-grow is its aspect ratio, so the row shares one
              height and nothing is cropped. */}
          <a
            class="row"
            href={`/work/${p.slug}`}
            aria-label={`${p.name} case study`}
            data-reveal
            data-delay="240"
            style={`--row-max: calc(${MAX_ROW_HEIGHT}rem * ${total.toFixed(4)})`}
          >
            {shots.map((s, i) => (
              <div class="cell" style={`--r: ${ratios[i].toFixed(4)}`}>
                <Shot shot={s} sizes={`(width < 48rem) ${s.kind === 'phone' ? '12rem' : '80vw'}, ${Math.round((ratios[i] / total) * 70)}rem`} />
              </div>
            ))}
          </a>
        </article>
      );
    })
  }
</section>

<style>
  .work { display: grid; gap: clamp(4rem, 9vw, 7rem); padding-top: 2rem; }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .project { min-width: 0; display: grid; gap: clamp(1.25rem, 3vw, 2rem); }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (width >= 48rem) {
    .meta { flex-direction: row; align-items: end; justify-content: space-between; gap: 3rem; }
    .right { max-width: 26rem; text-align: right; }
  }
  .idx { margin-bottom: 0.5rem; }
  .name {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);
    letter-spacing: -0.03em;
    width: fit-content;
    filter: drop-shadow(0 4px 14px rgb(0 0 0 / 0.5));
  }
  .summary { color: var(--ink-80); font-size: var(--step-1); }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    font-size: var(--step-0);
    color: var(--ink);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    & svg { transition: translate 0.3s var(--ease-out); }
    &:hover svg { translate: 2px 0; }
  }

  .row {
    display: flex;
    gap: clamp(0.6rem, 1.4vw, 1rem);
    max-width: min(100%, var(--row-max));
  }
  .cell { flex: var(--r) 1 0; min-width: 0; aspect-ratio: var(--r); }
  .cell :global(.frame) {
    height: 100%;
    border-radius: 10px;
    overflow: clip;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.04);
    box-shadow: 0 30px 70px -30px rgb(0 0 0 / 0.85);
    transition: translate 0.4s var(--ease-out), border-color 0.4s;
  }
  .cell :global(.frame img) { width: 100%; height: 100%; object-fit: contain; }
  .row:hover .cell :global(.frame) { translate: 0 -5px; border-color: var(--line-strong); }
  .row:hover .cell:nth-child(2) :global(.frame) { transition-delay: 40ms; }
  .row:hover .cell:nth-child(3) :global(.frame) { transition-delay: 80ms; }
  .row:hover .cell:nth-child(4) :global(.frame) { transition-delay: 120ms; }

  @media (width < 48rem) {
    .row {
      max-width: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter-x) * -1);
      padding-inline: var(--gutter-x);
      scroll-padding-inline: var(--gutter-x);
    }
    .cell { flex: 0 0 auto; height: 22rem; width: auto; scroll-snap-align: start; }
    .cell :global(.frame) { width: auto; height: 100%; aspect-ratio: var(--r); }
  }
</style>
