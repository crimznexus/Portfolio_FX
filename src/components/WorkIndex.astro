---
import Shot from './Shot.astro';
import { projects } from '../data/projects';
---

<section id="work" class="work wrap" aria-labelledby="work-title">
  <div class="section-head">
    <h2 id="work-title">Selected work</h2>
    <p class="label">{projects.length} projects · web, mobile, desktop</p>
  </div>

  <ol class="grid" role="list">
    {
      projects.map((p, i) => (
        <li class:list={['card', { feature: i === 0 }]}>
          <a href={`/work/${p.slug}`}>
            <div class:list={['media', p.cover.kind]}>
              <Shot
                shot={p.cover}
                sizes={i === 0 ? '(width < 52rem) 90vw, 46rem' : p.cover.kind === 'phone' ? '14rem' : '(width < 52rem) 80vw, 30rem'}
                eager={i === 0}
              />
            </div>
            <div class="info">
              <p class="label">{p.platform}</p>
              <h3 data-vt={p.slug}>{p.name}</h3>
              <p class="summary">{p.summary}</p>
              <span class="more">View project <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .work { padding-block: clamp(1rem, 3vw, 2rem) 0; }

  /* Two columns; each card spans two subgrid rows (image, text) so the text
     blocks of neighbouring cards start on the same line. */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 3vw, 2.5rem);
  }
  .card {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
  }
  .card > a {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 1.25rem;
    text-decoration: none;
  }

  .media {
    display: grid;
    place-items: end center;
    aspect-ratio: 16 / 11;
    padding: 9% 9% 0;
    overflow: clip;
    border-radius: var(--radius);
    background: var(--paper-2);
    transition: background-color 0.3s;
    min-width: 0;
    /* Hold the 16:11 box even when a tall phone capture is inside; it peeks out of the bottom edge. */
    min-height: 0;
    align-self: start;
  }
  .media :global(.frame) {
    width: 100%;
    border-end-start-radius: 0;
    border-end-end-radius: 0;
    transition: translate 0.45s var(--ease-out);
  }
  .media.phone { padding-top: 7%; }
  .media.phone :global(.frame) { width: min(42%, 15rem); border-bottom: 0; }

  .info { display: grid; gap: 0.45rem; align-content: start; }
  h3 { font-size: var(--step-2); }
  .summary { color: var(--ink-2); max-width: 44ch; }
  .more {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--ink-2);
    display: inline-flex;
    gap: 0.4rem;
  }
  .more span { transition: translate 0.25s var(--ease-out); }

  a:hover .media, a:focus-visible .media { background: var(--paper-3); }
  a:hover .media :global(.frame) { translate: 0 -6px; }
  a:hover .more { color: var(--accent); }
  a:hover .more span { translate: 3px 0; }

  /* First project: a wide card with the text beside the image. */
  .feature { grid-column: 1 / -1; grid-row: auto; grid-template-rows: none; }
  .feature > a {
    grid-row: auto;
    grid-template-rows: none;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .feature h3 { font-size: var(--step-3); }
  .feature .media { aspect-ratio: 16 / 10; }

  @media (width < 52rem) {
    .grid { grid-template-columns: 1fr; }
    .feature > a { grid-template-columns: 1fr; }
  }
</style>
