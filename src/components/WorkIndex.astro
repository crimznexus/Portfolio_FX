---
import Shot from './Shot.astro';
import { projects } from '../data/projects';
---

<section id="work" class="work wrap" aria-labelledby="work-title">
  <header class="work-head">
    <h2 id="work-title">Selected work</h2>
    <p class="label">{projects.length} projects · 2026</p>
  </header>

  <ol class="index" role="list">
    {
      projects.map((p, i) => (
        <li class="row" style={`--brand:${p.brand}; --anchor:--row-${i}`}>
          <a href={`/work/${p.slug}`} class="row-link">
            <span class="name" style={`view-transition-name:name-${p.slug}`}>{p.name}</span>
            <span class="desc">
              <span class="place">Used in {p.place}</span>
              <span class="summary">{p.summary}</span>
            </span>
            <span class="meta label">
              {p.platform}
              <span class="arrow" aria-hidden="true">→</span>
            </span>
            <Shot shot={p.cover} sizes="(width < 48rem) 40vw, 1px" class="row-thumb" />
          </a>
        </li>
      ))
    }
  </ol>

  {/* One floating preview for the whole list. Which image shows, and which row it sits
      beside, is decided in CSS with :has() and anchor positioning. No JavaScript. */}
  <div class="preview" aria-hidden="true">
    {
      projects.map((p, i) => (
        <div class="preview-item" data-i={i}>
          <Shot shot={p.cover} sizes="26rem" />
        </div>
      ))
    }
  </div>
</section>

<style>
  .work { position: relative; padding-block: clamp(2rem, 5vw, 4rem); }
  .work-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--ink);
  }
  h2 { font-size: var(--step-2); }

  .index {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr) minmax(0, 0.6fr);
  }
  .row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    border-bottom: 1px solid var(--line);
    anchor-name: var(--anchor);
  }
  .row-link {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    column-gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.1rem, 2.4vw, 1.8rem);
    text-decoration: none;
    position: relative;
  }
  .name {
    font-family: var(--font-display-stack);
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    transition: color 0.25s;
    width: fit-content;
  }
  .desc { display: grid; gap: 0.2rem; }
  .place {
    font-family: var(--font-display-stack);
    font-style: italic;
    font-size: var(--step-1);
  }
  .summary { color: var(--ink-2); font-size: var(--step--1); max-width: 46ch; }
  .meta {
    justify-self: end;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    text-align: right;
  }
  .arrow { transition: translate 0.25s var(--ease-out); }

  .row-link:hover .name,
  .row-link:focus-visible .name { color: var(--accent); }
  .row-link:hover .arrow { translate: 0.3rem 0; }

  /* Hide the inline thumbnail on wide, hover-capable screens; the floating preview takes over. */
  .row-link :global(.row-thumb) { display: none; }

  @media (width < 48rem) {
    .index { grid-template-columns: 1fr; }
    .row-link {
      grid-template-columns: minmax(0, 1fr) 7.5rem;
      grid-template-areas: 'name thumb' 'desc thumb' 'meta thumb';
      row-gap: 0.5rem;
    }
    .name { grid-area: name; font-size: var(--step-3); }
    .desc { grid-area: desc; }
    .meta { grid-area: meta; justify-self: start; }
    .row-link :global(.row-thumb) { display: block; grid-area: thumb; align-self: center; }
    .row-link :global(.row-thumb[data-kind='phone']) { width: 70%; justify-self: center; }
  }

  /* ---- Floating preview: anchor positioning + :has() ---- */
  .preview { display: none; }

  @supports (anchor-name: --a) and (position-area: center) {
    @media (hover: hover) and (width >= 48rem) {
      .preview { display: contents; }
      .preview-item {
        position: absolute;
        position-area: center span-inline-start;
        justify-self: end;
        align-self: center;
        margin-inline-end: 13rem;
        width: 22rem;
        pointer-events: none;
        opacity: 0;
        scale: 0.94;
        rotate: -1.5deg;
        transition: opacity 0.22s, scale 0.35s var(--ease-out), rotate 0.35s var(--ease-out);
        z-index: 2;
      }
      .preview-item:has(> [data-kind='phone']) { width: 12rem; }
    }
  }
</style>

<style is:global>
  /* Generated per row so each preview anchors to its own row and appears only while it's hovered. */
  @supports (anchor-name: --a) and (position-area: center) {
    @media (hover: hover) and (width >= 48rem) {
      .preview-item[data-i='0'] { position-anchor: --row-0; }
      .preview-item[data-i='1'] { position-anchor: --row-1; }
      .preview-item[data-i='2'] { position-anchor: --row-2; }
      .preview-item[data-i='3'] { position-anchor: --row-3; }
      .preview-item[data-i='4'] { position-anchor: --row-4; }
      .work:has(.row:nth-child(1) > a:is(:hover, :focus-visible)) .preview-item[data-i='0'],
      .work:has(.row:nth-child(2) > a:is(:hover, :focus-visible)) .preview-item[data-i='1'],
      .work:has(.row:nth-child(3) > a:is(:hover, :focus-visible)) .preview-item[data-i='2'],
      .work:has(.row:nth-child(4) > a:is(:hover, :focus-visible)) .preview-item[data-i='3'],
      .work:has(.row:nth-child(5) > a:is(:hover, :focus-visible)) .preview-item[data-i='4'] {
        opacity: 1;
        scale: 1;
        rotate: 0deg;
      }
    }
  }
</style>
