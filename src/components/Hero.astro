---
import { contact } from '../data/contact';
import { projects } from '../data/projects';
---

<section class="hero wrap" aria-labelledby="hero-title">
  <p class="status"><span class="dot" aria-hidden="true"></span> Open to frontend roles</p>
  <h1 id="hero-title">Muhammad Faizan</h1>
  <p class="lede">
    Frontend engineer. Below are {projects.length} projects across web, Android and desktop, shown
    as they run.
  </p>
  <ul class="links" role="list">
    <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
    <li><a href={contact.github.href}>GitHub</a></li>
    <li><a href={contact.linkedin.href}>LinkedIn</a></li>
  </ul>
</section>

<style>
  .hero { padding-block: clamp(3rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4.5rem); }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .dot { width: 0.45rem; aspect-ratio: 1; border-radius: 50%; background: var(--accent); }
  h1 { font-size: var(--step-4); margin-block: 0.9rem 0.9rem; }
  .lede { color: var(--ink-2); font-size: var(--step-1); max-width: 46ch; }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    font-size: var(--step--1);
  }
</style>
