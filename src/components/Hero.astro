---
import { contact } from '../data/contact';

const services = ['/ WEB APPS', '/ ANDROID APPS', '/ DESKTOP SOFTWARE'];
---

<section class="hero wrap screen" aria-labelledby="hero-title">
  <div class="top">
    <ul class="services" role="list">
      {
        services.map((s, i) => (
          <li class="label mono" data-reveal data-delay={150 + i * 120}>{s}</li>
        ))
      }
    </ul>

    <p class="intro shadow-text" data-reveal data-delay="300">
      Five projects, built end to end and photographed running: a dairy farm workspace, a flour
      mill ledger, an offline study tool, a game server dashboard and an Android client.
    </p>
  </div>

  <div class="bottom">
    <div class="left">
      <p class="badge" data-reveal data-delay="150">Open to frontend roles</p>
      <h1 id="hero-title" class="display" data-reveal data-delay="280">
        Muhammad Faizan.<br />Frontend engineer.
      </h1>
    </div>

    <div class="card glass" data-reveal data-delay="420">
      <span class="monogram" aria-hidden="true">MF</span>
      <div class="card-text">
        <p class="name">Talk to me directly</p>
        <p class="label">Email · Usually the fastest</p>
        <a class="btn" href={`mailto:${contact.email}`}>
          Start a conversation
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .top {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  @media (width >= 40rem) {
    .top { flex-direction: row; justify-content: space-between; }
    .intro { max-width: 22rem; text-align: right; }
  }
  .services { display: grid; gap: 0.5rem; }
  .mono { color: rgb(255 255 255 / 0.9); }
  .intro {
    font-size: var(--step-2);
    line-height: 1.6;
    max-width: 30rem;
  }

  .bottom {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  @media (width >= 48rem) {
    .bottom { flex-direction: row; align-items: end; justify-content: space-between; gap: 3rem; }
  }
  .badge { margin-bottom: 1.25rem; }

  .card {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-radius: 12px;
    padding: 0.75rem;
    background: rgb(255 255 255 / 0.15);
  }
  .monogram {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 6rem;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid var(--line);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .card-text { display: grid; gap: 0.375rem; padding-right: 0.5rem; }
  .name { font-size: var(--step-0); font-weight: 500; }
  .card .btn { margin-top: 0.375rem; padding: 0.5rem 1rem; font-size: var(--step-0); }
</style>
