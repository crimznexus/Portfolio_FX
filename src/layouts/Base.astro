---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Muhammad Faizan, frontend engineer. Work on dairy farms, flour mills, offline study tools, game hosting and Android.',
} = Astro.props;

const fullTitle = title ? `${title} · Muhammad Faizan` : 'Muhammad Faizan, frontend engineer';
const canonical = new URL(Astro.url.pathname, Astro.site);

const speculationRules = {
  prerender: [{ where: { href_matches: '/work/*' }, eagerness: 'moderate' }],
  prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#171815" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <!-- Apply a saved theme before first paint so there is no flash. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'system') document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    <!-- Only the project being opened (or returned to) morphs between pages.
         Names are assigned at navigation time so nothing else ghosts across. -->
    <script is:inline>
      (() => {
        const slugOf = (u) => new URL(u, location.href).pathname.match(/^\/work\/([^/]+)/)?.[1] ?? null;
        const name = (el, vt) => {
          if (!el) return;
          el.style.viewTransitionName = 'project-title';
          vt.finished.finally(() => (el.style.viewTransitionName = ''));
        };
        addEventListener('pageswap', (e) => {
          if (!e.viewTransition || !e.activation?.entry) return;
          const to = slugOf(e.activation.entry.url);
          name(to ? document.querySelector(`[data-vt="${to}"]:not(h1)`) : document.querySelector('h1[data-vt]'), e.viewTransition);
        });
        addEventListener('pagereveal', (e) => {
          if (!e.viewTransition) return;
          const here = slugOf(location.href);
          const act = window.navigation?.activation;
          const from = act?.from ? slugOf(act.from.url) : null;
          name(here ? document.querySelector('h1[data-vt]') : from && document.querySelector(`[data-vt="${from}"]`), e.viewTransition);
        });
      })();
    </script>

    <Font cssVariable="--font-display" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />

    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-inline-start: var(--gutter);
    inset-block-start: 0.5rem;
    z-index: 10;
    padding: 0.5rem 0.9rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius);
    translate: 0 -200%;
    transition: translate 0.2s var(--ease-out);
    &:focus { translate: 0 0; }
  }
</style>
