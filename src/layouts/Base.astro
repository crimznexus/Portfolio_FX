---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollBackdrop from '../components/ScrollBackdrop.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Muhammad Faizan, frontend engineer. Five projects across web, Android and Windows, shown as they run.',
} = Astro.props;

const fullTitle = title ? `${title} — Muhammad Faizan` : 'Muhammad Faizan — Frontend engineer';
const canonical = new URL(Astro.url.pathname, Astro.site);

const speculationRules = {
  prerender: [{ where: { href_matches: '/work/*' }, eagerness: 'moderate' }],
  prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <!-- Only the project being opened (or returned to) morphs between pages. -->
    <script is:inline>
      (() => {
        const slugOf = (u) => new URL(u, location.href).pathname.match(/^\/work\/([^/]+)/)?.[1] ?? null;
        const name = (el, vt) => {
          if (!el) return;
          el.style.viewTransitionName = 'project-title';
          vt.finished.finally(() => (el.style.viewTransitionName = ''));
        };
        addEventListener('pageswap', (e) => {
          if (!e.viewTransition || !e.activation?.entry) return;
          const to = slugOf(e.activation.entry.url);
          name(to ? document.querySelector(`[data-vt="${to}"]:not(h1)`) : document.querySelector('h1[data-vt]'), e.viewTransition);
        });
        addEventListener('pagereveal', (e) => {
          if (!e.viewTransition) return;
          const here = slugOf(location.href);
          const act = window.navigation?.activation;
          const from = act?.from ? slugOf(act.from.url) : null;
          name(here ? document.querySelector('h1[data-vt]') : from && document.querySelector(`[data-vt="${from}"]`), e.viewTransition);
        });
      })();
    </script>

    <Font cssVariable="--font-sans" preload />

    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <ScrollBackdrop />
    <div class="page">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      // Staggered fade-up as blocks enter the viewport.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!items.length) {
        // nothing to do
      } else if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.style.setProperty('--delay', `${el.dataset.delay ?? 0}ms`);
              el.classList.add('is-in');
              io.unobserve(el);
            });
          },
          { threshold: 0.15 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .page { position: relative; z-index: 10; display: flex; flex-direction: column; min-height: 100dvh; }
  .page > :global(main) { flex: 1; }
  .skip {
    position: absolute;
    inset-inline-start: var(--gutter-x);
    inset-block-start: 0.5rem;
    z-index: 60;
    padding: 0.5rem 0.9rem;
    background: var(--ink);
    color: #000;
    border-radius: 6px;
    translate: 0 -200%;
    transition: translate 0.2s var(--ease-out);
    &:focus { translate: 0 0; }
  }
</style>
